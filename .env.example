# Optional Supabase Auth verification. Keep the anon/publishable key server-side here;
# never add a service-role key to client-side VITE_ variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio may inject this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: Public base URL of this app, without a trailing slash.
APP_URL=

# Optional Gemini model override (defaults to gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash

# TikTok Content Posting API. Configure only in server-side environment variables.
# Register this exact redirect URI in TikTok Developer Portal:
# https://YOUR_APP_HOST/api/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Generate with: openssl rand -base64 32 (must decode to exactly 32 bytes).
TIKTOK_TOKEN_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
TIKTOK_SESSION_SECRET=

# Durable Upstash Redis REST storage; do not expose these values to the browser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
