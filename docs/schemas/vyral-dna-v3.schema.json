{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VYRA Asset DNA v3",
  "description": "Portable lossless decoded-sample representation with optional exact original encoded-file chunks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "record_id",
    "source",
    "extractor",
    "decoded_image",
    "lossless_payload"
  ],
  "properties": {
    "schema_id": {
      "const": "vyra.asset-dna"
    },
    "schema_version": {
      "const": 3
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_version_id",
        "sha256",
        "size_bytes",
        "mime_type"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "asset_version_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "mime_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decoded_image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "sample_format",
        "channel_layout",
        "color_space",
        "icc_profile_sha256",
        "alpha_mode",
        "decoder_contract",
        "decoded_samples_sha256"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sample_format": {
          "const": "uint8"
        },
        "channel_layout": {
          "enum": [
            "RGB",
            "RGBA"
          ]
        },
        "color_space": {
          "type": "string",
          "minLength": 1
        },
        "icc_profile_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "alpha_mode": {
          "enum": [
            "none",
            "straight",
            "premultiplied",
            "unknown"
          ]
        },
        "decoder_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "color_management"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "color_management": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "decoded_samples_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sample_layout": {
          "type": "object",
          "additionalProperties": false,
          "description": "Canonical byte layout for decoded_samples_sha256. Required in portable DNA-only packages.",
          "required": [
            "row_order",
            "pixel_order",
            "channel_order",
            "packing",
            "row_stride",
            "hash_algorithm",
            "hash_scope"
          ],
          "properties": {
            "row_order": {
              "const": "top-to-bottom"
            },
            "pixel_order": {
              "const": "left-to-right"
            },
            "channel_order": {
              "enum": [
                "RGB",
                "RGBA"
              ]
            },
            "packing": {
              "const": "interleaved"
            },
            "row_stride": {
              "const": "tightly-packed"
            },
            "hash_algorithm": {
              "const": "SHA-256"
            },
            "hash_scope": {
              "const": "full-decoded-sample-stream"
            }
          }
        }
      }
    },
    "lossless_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "tile_width",
        "tile_height",
        "tiles"
      ],
      "properties": {
        "encoding": {
          "const": "raw-tiled-v1"
        },
        "tile_width": {
          "type": "integer",
          "minimum": 1
        },
        "tile_height": {
          "type": "integer",
          "minimum": 1
        },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height",
              "byte_length",
              "sha256",
              "package_path"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "byte_length": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "package_path": {
                "type": "string",
                "pattern": "^dna/v3/[A-Za-z0-9_-]{1,128}/tiles/[0-9]+_[0-9]+\\.raw$"
              }
            }
          }
        }
      }
    },
    "encoded_file_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "filename",
        "mime_type",
        "size_bytes",
        "sha256",
        "chunk_size",
        "chunks"
      ],
      "properties": {
        "encoding": {
          "const": "raw-chunks-v1"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "chunk_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "byte_length",
              "sha256",
              "package_path"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "byte_length": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "package_path": {
                "type": "string",
                "pattern": "^dna/v3/[A-Za-z0-9_-]{1,128}/source/[0-9]+\\.bin$"
              }
            }
          }
        }
      }
    }
  }
}
